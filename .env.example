# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security
SECRET_KEY=super-secret-jwt-devops-guardrails-key-2026

# Database
DATABASE_URL=sqlite:///./devops_agent.db

# Docker Sandbox Execution
USE_DOCKER=true
DOCKER_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=60

# Guardrails
GUARDRAIL_CONFIDENCE_THRESHOLD=0.75
MAX_RETRY_CYCLES=2

# LLM Providers (mock | openai | anthropic | gemini | ollama)
LLM_PROVIDER=mock
MODEL_NAME=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# GitHub Integration
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
